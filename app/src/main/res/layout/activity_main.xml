<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml: trang chủ hiển thị danh sách ảnh -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Thanh tiêu đề Material 3, chứa nút Logout (menu_main.xml) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#B71C1C"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="@string/title_gallery"
        app:titleTextColor="#FFFFFF" />

    <!-- Header: avatar tròn + lời chào -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- BONUS 2: avatar, Glide cắt thành hình tròn bằng circleCrop() -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/avatar_desc"
            android:scaleType="centerCrop" />

        <!-- Lời chào: hiển thị email người dùng đang đăng nhập -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#212121"
            android:textSize="15sp"
            tools:text="Hello, test@gmail.com" />
    </LinearLayout>

    <!-- Danh sách ảnh cuộn dọc -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPhotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp"
        tools:listitem="@layout/item_photo" />
</LinearLayout>
